# ============================================
# 🔐 SECRET - Data Rahasia (Password, dll)
# ============================================
# Secret menyimpan data sensitif (password, API key, dll)
# 
# CARA MEMBUAT:
# 1. Copy file ini menjadi secret.yaml
# 2. Encode semua value dengan base64:
#    echo -n "your-value" | base64
# 3. Isi value yang sudah di-encode
# 4. JANGAN commit secret.yaml ke Git!

apiVersion: v1
kind: Secret
metadata:
  name: inventorygudang-secret
  namespace: inventorygudang
type: Opaque
data:
  # APP_KEY (Laravel encryption key)
  # Generate dengan: php artisan key:generate
  # Lalu encode: echo -n "base64:xxxxx" | base64
  APP_KEY: "BASE64_ENCODED_APP_KEY_HERE"
  
  # Database credentials
  DB_CONNECTION: "bXlzcWw="  # mysql (base64)
  DB_HOST: "YOUR_DB_HOST_BASE64"
  DB_PORT: "MzMwNg=="  # 3306 (base64)
  DB_DATABASE: "YOUR_DB_NAME_BASE64"
  DB_USERNAME: "YOUR_DB_USER_BASE64"
  DB_PASSWORD: "YOUR_DB_PASSWORD_BASE64"
  
  # Mail configuration (opsional)
  MAIL_MAILER: "c210cA=="  # smtp (base64)
  MAIL_HOST: "YOUR_MAIL_HOST_BASE64"
  MAIL_PORT: "NTg3"  # 587 (base64)
  MAIL_USERNAME: "YOUR_MAIL_USER_BASE64"
  MAIL_PASSWORD: "YOUR_MAIL_PASSWORD_BASE64"
  MAIL_ENCRYPTION: "dGxz"  # tls (base64)
  MAIL_FROM_ADDRESS: "YOUR_MAIL_FROM_BASE64"

---
# ALTERNATIF: Pakai Google Secret Manager (Lebih Aman!)
# Uncomment jika mau pakai Secret Manager

